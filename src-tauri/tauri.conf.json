{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SLAI SciCal",
  "version": "2.4.0",
  "identifier": "app.slai.scical",
  "build": {
    "frontendDist": "./splash"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "SLAI SciCal",
        "width": 1280,
        "height": 840,
        "minWidth": 360,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "A scientific calculator and STEM workbench",
    "longDescription": "SLAI SciCal: exact and numeric calculation, graphing in 2D and 3D, chemistry, biology, measurement, formulas and STEM checks. Everything runs on your device.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "iOS": {
      "minimumSystemVersion": "15.0"
    },
    "android": {
      "minSdkVersion": 26
    }
  }
}
