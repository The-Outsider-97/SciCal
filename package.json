{
  "name": "slai-scical",
  "version": "2.4.0",
  "description": "SLAI SciCal - a scientific calculator and STEM workbench on your own computer. TypeScript client + Python SLAI service.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/build-static.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests_ts/*.test.ts",
    "test:py": "python3 -m unittest discover -s tests -v",
    "start": "npm run build && python3 -m scical"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
